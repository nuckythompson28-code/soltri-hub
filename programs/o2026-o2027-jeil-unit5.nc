%
  O2026 (MAIN PROGRAM);
  (SIZE DEF);
  #100=246 (CHUCK LENGTH);
  #101=145. (MATERIAL OD);
  #102=126. (MATERIAL ID);
  #103=140. (WORK OD);
  #104=127.20 (WORK ID);
  #105=9.87 (WORK LENGTH);
  #106=1.97 (T02 TIP WIDTH);
  ;
  (CHAMFER SIZE DEF);
  #107=1.20 (ID RIGHT);
  #108=0.45 (OD RIGHT);
  #109=0. (ID LEFT);
  #110=0.60 (OD LEFT);
  ;
  (GROOVING SIZE DEF);
  #119=1 (0=OFF, 1=ON);
  #120=3.70 (GROOVING DEPTH);
  #121=2. (GROOVING SIZE);
  ;
  (RPM FEED);
  #111=1200 (T01 BORING BAR MIN RPM);
  #112=1200 (T01 BORING BAR MAX RPM);
  #113=0.12 (STEP CUTTING T01 FEED1);
  #114=0.11 (GROOVING SIZE T01 FEED2);
  #115=0.025 (GROOVING DEPTH T01 FEED3);
  ;
  #116=1200 (T02 MIN RPM);
  #117=1200 (T02 MAX RPM);
  #118=0.10 (T02 FEED);
  ;
  M98 P2027;
  M05;
  M30;

  O2027 (60G);
  #555=[#105-#121]/2 (WORK BOTH SIDE WIDTH);
  #530=5 (CHUCK SAFETY);
  #500=#100-#530;
  #501=#101+4.0;
  #502=#102-3.5;
  #503=#103+4.0;
  #504=#104-5.0;
  #505=#105+#106 (WORK+T02 LENGTH);
  #506=55 (BORING BAR MAX WIDTH);
  #507=1.0 (BORING BAR MIN WIDTH);
  #510=1.0 (CHAMFER VALUE);
  #549=FIX[#100/#505];
  IF [#549 EQ 1] THEN #549=2.0;
  N10;
  #511=[#112-#111]/[#549-1.0];
  #512=[#117-#116]/[#549-1.0];
  #517=FIX[#500/#505];
  #518=#517*#505;
  G10 L2 P0 Z[#100];
  G30 U0 W0 M55;
  G00 U150;
  N100 (FACE CUTTING);
  #513=#111;
  #514=#116;
  G00 X-[#101+5.0] T02;
  G00 Z0. T02;
  M00;
  G97 M03 S#514;
  G98 G01 X-[#502] F[#514*#118];
  G00 X-[#501] M52;
  Z20.0;
  #515=FIX[[#506-#507]/#505];
  #516=#515*#505;
  #521=0;
  #522=#521*#505;
  N120 (IMPACT PREVENTION);
  IF [#515 LE #517] GOTO 130;
  #515=#517;
  #516=#515*#505;
  N130 (STEP CUTTING);
  G00 X#103 M53 T01;
  Z[-#522+20.0];
  G97 G00 Z[-#522+5.0] S#513 M03;
  G98 G01 Z-[#522+#516] F[#513*#113];
  M54;
  G04 P700;
  G01 U0.2;
  G00 W[#516+#510];
  #520=0;
  N150 (CHAMFER CUTTING);
  G00 X#103 T01;
  G97 G00 Z[-#522+2.0] S#513 M03;
  G98 G01 Z[-#522+#510] F[#513*#114];
  G01 X[#103-[[#510+#108]*2.0]];
  X[#103+[[#510+#107]*2.0]];
  IF [#119 EQ 0] GOTO 170;
  N160 (GROOVING);
  G00 X[#103+0.1] T01;
  G00 Z[-#522-#555];
  G01 X[#103-#120] F[#513*#115];
  G01 Z[-#522-#555-#121] F[#513*#113];
  G00 X[#103+0.1];
  G00 Z[-#522+20.0];
  #513=#513+#511;
  N170 (COUNT);
  #520=#520+1;
  #521=#521+1;
  #522=#522+#505;
  N180 (CUTTING);
  G00 X-[#503] T02;
  Z[#110-#522];
  G97 G00 X-[#103+1.0] S#514 M03;
  G98 G01 X-[#103] F[#514*#118];
  U[#110*2.0] W-[#110];
  X-[#504] M51;
  G00 X-[#101+10.0];
  W10.0 M52;
  #514=#514+#512;
  M12;
  N190 (IF OR ELSE);
  IF [#520 LT #515] GOTO 150;
  G00 W10.0 T02;
  IF [[#521+#515] GT #517] GOTO 200;
  GOTO 130;
  N200 (LAST CUTTING);
  #515=FIX[[#500-#522]/#505];
  #516=#515*#505;
  IF [#515 GE 1] GOTO 130;
  N250 (WORK RETRACT);
  M54;
  M05;
  G30 U0 W0;
  M99;
  %
